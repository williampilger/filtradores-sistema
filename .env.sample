# ─────────────────────────────────────────────────────────────────────────────
# Filtradores - variáveis de ambiente (copiar para `.env` na raiz do repo)
# Este arquivo é lido pelo apps/web, apps/worker, packages/db e apps/mobile (só EXPO_PUBLIC_*).
# ⚠️ NUNCA commitar o `.env` real!
# ─────────────────────────────────────────────────────────────────────────────

# Comportamento geral
SUPPRESS_RESPONSE_ERROR_MESSAGES=false   # true em produção: esconde stack/mensagens internas do cliente
SERVER_UNDER_MAINTENANCE=false           # true: todas as rotas de API retornam 503
APP_URL=https://filtradores.pilger.dev.br # URL pública do front (links de e-mail, retorno dos gateways, webhooks)
PORT=26006

# Banco (container compartilhado `mysql-dev`) / cache
DATABASE_URL=mysql://userfiltradores:senha-forte@localhost:3306/filtradores
SHADOW_DATABASE_URL=mysql://userfiltradores:senha-forte@localhost:3306/filtradores-shadow   # usado pelo prisma migrate dev/diff
TEST_DATABASE_URL=mysql://userfiltradores:senha-forte@localhost:3306/filtradores-test     # testes de integração (npm test) - banco descartável
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6393

# Sessões / 2FA
SESSION_MAX_AGE_DAYS=60                  # sessão expira após N dias SEM USO (expiração deslizante; o app mobile depende disso)
COOKIE_SECURE=false                      # true em produção (HTTPS via Cloudflare)
TOTP_ISSUER=Filtradores                  # nome exibido no app autenticador (Google Authenticator, Authy...)
LOGIN_MAX_ATTEMPTS=8                     # tentativas de login/2FA por IP+e-mail a cada 15 min

# Logs
LOG_LEVEL=debug                          # trace | debug | info | warn | error | fatal
LOG_PRETTY=true
GOOGLE_CHAT_WEBHOOK=                     # Vazio = notificações desabilitadas (INFO/ERROR/fatal)

# Criptografia (AES-256-GCM) das credenciais dos gateways e do segredo TOTP
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ Trocar a chave torna ilegíveis as credenciais/2FA já salvos.
ENCRYPTION_KEY=
# Assinatura do QR rotativo da carteirinha de sócio (HMAC). Mesmo comando acima.
QR_SIGNING_SECRET=

# Armazenamento de arquivos (fotos de usuários/jogadores, imagens de produtos, capas de eventos)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=.storage              # relativo à raiz do repo
UPLOAD_MAX_MB=10

# Usuário MASTER criado pelo seed (2FA obrigatório no primeiro login)
MASTER_EMAIL=master@filtradores.local
MASTER_PASSWORD=troque-esta-senha
MASTER_NAME=Master

# E-mail (SMTP). Vazio = e-mails apenas logados (o link aparece no log do worker)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false                        # true para porta 465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Filtradores <nao-responda@filtradores.local>

# ─── Pagamentos ─────────────────────────────────────────────────────────────
# Credenciais dos gateways ficam no BANCO (criptografadas) - tela Admin > Gateways.
PAYMENTS_WEBHOOK_BASE=                   # Vazio = APP_URL. URL pública que recebe os webhooks (/api/v1/webhooks/payments/<gateway>)
ORDER_RESERVATION_MINUTES=20             # tempo que o estoque/ingresso fica reservado aguardando pagamento
ORDERS_EXPIRE_CRON=* * * * *             # varredura de pedidos expirados (devolve estoque)
PAYMENTS_RECONCILE_CRON=*/5 * * * *      # consulta nos gateways os pagamentos pendentes (fallback do webhook)

# ─── Sócios ─────────────────────────────────────────────────────────────────
MEMBERSHIP_BILLING_CRON=0 7 * * *        # gera cobranças de renovação / marca inadimplência
MEMBERSHIP_BILLING_DAYS_BEFORE=7         # gera a cobrança N dias antes do fim do período
MEMBERSHIP_GRACE_DAYS=10                 # dias de carência após o vencimento antes de ficar INADIMPLENTE
MEMBERSHIP_EXPIRE_DAYS=60                # dias inadimplente até EXPIRAR o vínculo

# ─── Loja / lista de espera ─────────────────────────────────────────────────
WAITLIST_RESERVATION_HOURS=48            # prazo para quem foi chamado na lista de espera comprar
WAITLIST_CRON=*/10 * * * *               # expira chamadas vencidas e chama os próximos

# ─── App mobile (Expo) ──────────────────────────────────────────────────────
# URL da API vista pelo celular. Em dev: IP da máquina na rede (ex.: http://192.168.0.10:3000) ou http://sony:26006
EXPO_PUBLIC_API_URL=http://localhost:3000
